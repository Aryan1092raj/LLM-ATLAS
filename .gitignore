# =====================================================================
# LLM Atlas — gitignore
# =====================================================================

# --- Node / CRA ----------------------------------------------------
node_modules/
/.pnp
.pnp.js
/coverage
/build
*.tsbuildinfo

# --- npm / yarn / pnpm ---------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json.bak

# --- Python (ingestion pipeline) -----------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
.eggs/
myenv/

# --- Local env / secrets -------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Test / debug output -------------------------------------------
*.log
*.pid
*.seed
*.pid.lock

# --- IDE / editor --------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Tooling caches ------------------------------------------------
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# --- Agent / workspace metadata (NEVER commit) ---------------------
.agents/
.claude/
.commandcode/
.brain/
.serena/
skills-lock.json

# --- Loose root image copies -----------------------------------------
/all_models.png

# --- Pipeline: raw snapshots + per-run artifacts (regenerated by CI) ---
data/raw/
data/processed/20*/
data/processed/alias_index.json

# --- Loose asset bundles (re-generate via tooling, don't commit) ---
favicon.zip
*.zip
*.tar.gz
*.tar
*.tgz

# --- One-off scratch space -----------------------------------------
/tmp/
/scratch/
docs/

# --- Dev throwaway screenshots / debug captures --------------------
/public/tmp_check-*.png
/public/tmp_*.png
/public/check_*.png
/public/debug_*.png
/public/screenshot-*.png